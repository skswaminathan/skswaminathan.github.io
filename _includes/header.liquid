<header class="site-header">
  <nav id="navbar" class="navbar" aria-label="Primary">
    <div class="container nav-container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand" href="{{ '/' | relative_url }}">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }}</span>
            {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </a>
      {% endif %}

      <div class="nav-links">
        {% if site.enable_darkmode %}
          <button id="light-toggle" class="theme-toggle" type="button" aria-label="Change theme" title="Change theme">
            <span class="theme-toggle-mark" aria-hidden="true"></span>
          </button>
        {% endif %}
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <progress id="progress" value="0" max="100" aria-hidden="true"></progress>
  {% endif %}
</header>
