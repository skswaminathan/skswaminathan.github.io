<figure>
  <img
    src="{{ include.path | relative_url }}"
    {% if include.class %}
      class="{{ include.class }}"
    {% endif %}
    {% if include.alt %}
      alt="{{ include.alt }}"
    {% endif %}
    {% if include.loading %}
      loading="{{ include.loading }}"
    {% endif %}
  >
  {% if include.caption %}
    <figcaption class="caption">{{ include.caption }}</figcaption>
  {% endif %}
</figure>
